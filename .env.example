# Copie para .env e preencha. O arquivo .env NUNCA deve ser commitado.

# URL do webhook do Discord (é um segredo: quem tiver a URL pode postar no seu canal)
DISCORD_WEBHOOK_URL=

# Chave que o n8n usa para criptografar as credenciais salvas.
# Gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Fuso horário do agendamento
GENERIC_TIMEZONE=America/Sao_Paulo
