# Copie para .env e preencha. O arquivo .env NUNCA deve ser commitado.

# Chave que o n8n usa para criptografar as credenciais salvas (obrigatória).
# Gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Versão da imagem do n8n (ex.: 1.2.3). Vazio = latest.
N8N_VERSION=

# Fuso horário do agendamento
GENERIC_TIMEZONE=America/Sao_Paulo

# O webhook do Discord NÃO fica aqui: ele é salvo como credencial
# criptografada dentro do n8n (tipo "Discord Webhook"). Ver SECURITY.md.
